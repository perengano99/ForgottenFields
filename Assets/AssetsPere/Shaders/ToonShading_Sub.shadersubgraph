    "m_SourceType": 1,
    "m_FunctionName": "AddLights",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#ifdef SHADERGRAPH_PREVIEW\r\n    AddColor = float3(0,0,0);\r\n#else\r\n    float3 result = 0;\r\n    #if defined(UNIVERSAL_LIGHTING_INCLUDED)\r\n        uint pixelLightCount = GetAdditionalLightsCount();\r\n        for (uint i = 0; i < pixelLightCount; ++i) {\r\n            Light light = GetAdditionalLight(i, WorldPos);\r\n            float NdotL = dot(WorldNormal, light.direction);\r\n            float toon = smoothstep(-ToonSmoothness, ToonSmoothness, NdotL);\r\n            float atten = light.distanceAttenuation * light.shadowAttenuation;\r\n            result += light.color * (toon * atten);\r\n        }\r\n    #endif\r\n    AddColor = result * BaseColor;\r\n#endif"
}

